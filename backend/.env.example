PORT=3001
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Optional secondary admin account. This account can view users, plans,
# reports, audit events, and system health, but cannot edit or delete accounts.
SECONDARY_ADMIN_EMAIL=secondary-admin@yourdomain.com
SECONDARY_ADMIN_PASSWORD=replace_with_a_different_strong_unique_password

# Optional path relative to the project root; defaults to the Firebase Admin
# service-account JSON file placed in this backend folder.
# FIREBASE_SERVICE_ACCOUNT_PATH=backend/your-service-account-file.json

# Optional: used only for driving distance/time calculations via Google Routes.
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key

# Optional: match accommodation listings to Google Places photos.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Optional Geoapify Places API key for nearby accommodation listings.

# HOTEL_API_PROVIDER selects live hotel offers; nearby listings are separate.
HOTEL_API_PROVIDER=hotelbeds

# Hotelbeds test credentials. Search rates and static property content/photos.
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_API_BASE_URL=https://api.test.hotelbeds.com

# Optional Nuitee Connect (LiteAPI) integration. Sandbox and production use
# the same API base URL; the key determines the account environment.
# Select HOTEL_API_PROVIDER=nuitee and paste your sandbox key here.
# NUITEE_API_BASE_URL=https://api.liteapi.travel/v3.0
# NUITEE_API_KEY=
# NUITEE_GUEST_NATIONALITY=ZA

# Optional ScrapeBadger Google Hotels integration. Select
# HOTEL_API_PROVIDER=scrapebadger to enable search results, rates, and photos.
# Keep this key server-side; a successful search uses ScrapeBadger credits.
# SCRAPEBADGER_API_KEY=your_scrapebadger_api_key
# SCRAPEBADGER_CURRENCY=ZAR

# Optional live hotel rates. Set HOTEL_API_PROVIDER=amadeus and provide
# Amadeus Self-Service API credentials to request date-specific offers.
# HOTEL_API_PROVIDER=amadeus
# HOTEL_API_KEY=your_amadeus_client_id
# HOTEL_API_SECRET=your_amadeus_client_secret
# HOTEL_API_BASE_URL=
# HOTEL_API_TOKEN_URL=
# HOTEL_API_HOST=

# Hotelbeds API credentials (server-side only; never use EXPO_PUBLIC_).
# Add both values from your Hotelbeds API account.


# Hotelbeds sandbox by default; use https://api.hotelbeds.com after production approval.


# Optional EmailJS template used for booking request and payment reference emails.
EMAILJS_BOOKING_SERVICE_ID=
EMAILJS_BOOKING_TEMPLATE_ID=
EMAILJS_BOOKING_PUBLIC_KEY=
EMAILJS_BOOKING_PRIVATE_KEY=

