PORT=3001

HOTEL_API_PROVIDER=none

# Firebase Web app configuration (Expo client-side values).
# Copy the values from Firebase Console > Project settings > Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Optional: driving distance/time calculations via Google Routes only.
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key

# Optional hotel provider credentials.
# HOTEL_API_PROVIDER=amadeus
# HOTEL_API_KEY=your_amadeus_client_id
# HOTEL_API_SECRET=your_amadeus_client_secret
# AMADEUS_API_BASE_URL=https://test.api.amadeus.com
# AMADEUS_AUTH_URL=https://test.api.amadeus.com/v1/security/oauth2/token

# EmailJS is needed for email OTP and password reset.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_OTP_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Optional application URL used in password-reset links.
# APP_BASE_URL=http://localhost:8082

# Optional third-party hotel API configuration.
# HOTEL_API_BASE_URL=
# HOTEL_API_TOKEN_URL=
# HOTEL_API_HOST=
