# Google Places API key (keep the real value in backend/.env only)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
PORT=3001

# Frontend API URL. Use localhost for Expo web on this computer.
# For Expo Go on a physical phone, replace localhost with your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional. Enables Travel Lens image landmark recognition through Google Cloud Vision.
# Without this key, the app still captures photos and returns possible matches instead of guessing.
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Google Places powers live accommodation discovery using the same key above.
HOTEL_API_PROVIDER=google

# EmailJS credentials for registration OTP, login OTP, and password reset emails.
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_password_reset_template_id_here
EMAILJS_OTP_TEMPLATE_ID=your_emailjs_otp_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=

# Optional third-party hotel API layer. Leave disabled unless configured.
# HOTEL_API_PROVIDER=none
# HOTEL_API_KEY=
# HOTEL_API_SECRET=
# HOTEL_API_BASE_URL=
# HOTEL_API_TOKEN_URL=
# HOTEL_API_HOST=
